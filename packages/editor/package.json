{
  "name": "@visual-html/editor",
  "version": "0.1.0",
  "description": "Open a local HTML file in Visual HTML Editor with one command.",
  "license": "MIT",
  "keywords": ["html", "editor", "wysiwyg", "cli", "visual"],
  "type": "module",
  "engines": { "node": ">=20.19.0" },
  "bin": { "visual-html": "./bin/visual-html.mjs" },
  "files": ["bin", "dist", "README.md", "LICENSE"],
