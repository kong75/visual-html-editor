{
  "name": "@visual-html/editor",
  "version": "0.1.0",
  "description": "Open a local HTML file in Visual HTML Editor with one command.",
  "license": "MIT",
  "keywords": [
    "html",
    "editor",
    "wysiwyg",
    "cli",
    "visual"
  ],
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "bin": {
    "visual-html": "./bin/visual-html.mjs"
  },
  "files": [
    "bin",
    "dist",
    "registry",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "registry:build": "node ../../scripts/build-source-registry.mjs",
    "build": "pnpm registry:build && vite build",
    "prepack": "pnpm registry:build",
    "pretest": "pnpm registry:build",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "publint": "publint"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@visual-html/core": "workspace:*",
    "@visual-html/react": "workspace:*",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kong75/visual-html-editor.git",
    "directory": "packages/editor"
  },
  "homepage": "https://github.com/kong75/visual-html-editor/tree/main/packages/editor#readme",
  "bugs": {
    "url": "https://github.com/kong75/visual-html-editor/issues"
  }
}
