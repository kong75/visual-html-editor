{
  "name": "@visual-html/core",
  "version": "0.1.0",
  "description": "Framework-neutral source engine for Visual HTML Editor.",
  "license": "MIT",
  "keywords": [
    "html",
    "editor",
    "wysiwyg",
    "email",
    "source-preserving",
    "typescript"
  ],
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./profiles/email": {
      "types": "./dist/profiles.d.ts",
      "import": "./dist/profiles.js",
      "default": "./dist/profiles.js"
    },
    "./profiles/slides": {
      "types": "./dist/profiles.d.ts",
      "import": "./dist/profiles.js",
      "default": "./dist/profiles.js"
    },
    "./profiles/web": {
      "types": "./dist/profiles.d.ts",
      "import": "./dist/profiles.js",
      "default": "./dist/profiles.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only"
  },
  "dependencies": {
    "css-tree": "3.2.1",
    "entities": "^8.1.0",
    "magic-string": "^1.3.1",
    "parse5": "^8.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kong75/visual-html-editor.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/kong75/visual-html-editor/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/kong75/visual-html-editor/issues"
  },
  "devDependencies": {
    "@types/css-tree": "3.2.0"
  }
}
