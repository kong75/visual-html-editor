{
  "name": "visual-html-editor-workspace",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "scripts": {
    "dev": "pnpm --filter @visual-html/showcase dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test && pnpm test:repo",
    "test:repo": "vitest run --config vitest.repo.config.mts",
    "test:coverage": "vitest run --config vitest.coverage.config.mts --coverage",
    "test:mutation": "stryker run",
    "typecheck": "pnpm -r typecheck",
    "test:e2e": "playwright test",
    "test:e2e:all": "cross-env VHE_E2E_ALL_BROWSERS=1 playwright test",
    "test:e2e:packed": "playwright test --config playwright.packed.config.ts",
    "test:e2e:packed:prepare": "pnpm test:consumers && pnpm test:e2e:packed",
    "test:consumers": "pnpm build && node scripts/test-consumers.mjs",
    "test:api": "pnpm build && node scripts/check-public-api.mjs",
    "api:update": "pnpm build && node scripts/check-public-api.mjs --update",
    "lint:packages": "pnpm --filter @visual-html/core --filter @visual-html/deck --filter @visual-html/react publint",
    "test:types": "pnpm --filter @visual-html/core --filter @visual-html/deck --filter @visual-html/react attw",
    "check": "pnpm check:versions && pnpm check:docs && pnpm test:tooling && pnpm typecheck && pnpm test && pnpm build && pnpm lint:packages",
    "release:check": "pnpm check && pnpm test:coverage && pnpm test:types && pnpm test:api && pnpm test:consumers && pnpm test:runtime && pnpm test:e2e:packed && pnpm test:e2e:all",
    "test:tooling": "node --test scripts/*.test.mjs",
    "test:e2e:edge": "cross-env VHE_E2E_BROWSER=edge playwright test",
    "test:runtime": "node scripts/test-runtime-consumer.mjs",
    "release:version": "node scripts/release-version.mjs",
    "check:versions": "node scripts/release-version.mjs --check",
    "check:docs": "node scripts/check-docs.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@axe-core/playwright": "4.10.2",
    "@babel/parser": "7.29.8",
    "@playwright/test": "^1.62.1",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "cross-env": "^10.0.0",
    "jsdom": "^29.1.1",
    "publint": "^0.3.23",
    "semver": "7.8.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
